{
  "manifest_version": 3,
  "name": "Palette box",
  "version": "1.0.0",
  "description": "Pull out when you pick color, save it and give to develop environment",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup_default.html"
  },
  "default_locale": "en",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "tabs",
    "storage",
    "identity"
  ],
  "oauth2": {
    "client_id": "853620929624-c5f56qp6689bt5uu8jprkqr8m1lo08pu.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/userinfo.email"]
  },
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
